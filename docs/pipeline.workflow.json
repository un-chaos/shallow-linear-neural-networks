          "teacher",
          "sampler"
        ],
        "note": "teacher 权重 w̄ 固定不动；训练集只由它生成一次，之后被反复使用。"
      },
      {
        "id": "loop",
        "label": "训练：全量梯度下降循环",
        "focus": [
          "sample-batch",
          "grad-step",
          "config"
        ],
        "note": "所有 P 个样本一起算梯度，每个 epoch 走一步，直到 epoch 用完。"
      },
      {
        "id": "deliver",
        "label": "产出：CSV、曲线与自检",
        "focus": [
          "csv",
          "plot",
          "selfcheck"
        ],
        "note": "每个 epoch 一条记录，train 与 test loss 画在同一张图里。"
