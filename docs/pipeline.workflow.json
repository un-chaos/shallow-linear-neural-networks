  "cards": [
    {
      "dot": "cyan",
      "title": "四个可调旋钮",
      "items": [
        "N：输入维度，也等于 student 的参数量",
        "P：训练样本数，同时是测试集大小",
        "epoch：全量梯度下降的步数",
        "test_every：每多少轮用新数据测一次"
      ]
    },
    {
      "dot": "amber",
      "title": "train 与 test 的关键区别",
      "items": [
        "训练集只由 teacher 生成一次，然后被反复拟合",
        "测试集每次测量都由 teacher 重新生成，永远是没见过的数据",
        "所以 test loss 衡量真正的泛化误差，不是拟合程度"
      ]
    },
    {
      "dot": "emerald",
      "title": "读曲线时要知道的两件事",
      "items": [
        "train loss 有下界 σ²(P−N)/P，降不到 0 是数据性质，不是没收敛",
        "单次 test loss 的真实波动约 2‖w−w̄‖/√P，想平滑就加大 --n-test"
      ]
    },
    {
      "dot": "violet",
      "title": "扩展到相图（phase_diagram.py）",
      "items": [
        "对 (N, P) 网格逐格跑同一套流程，颜色表示 final / best test loss",
        "P < N 是过拟合区，test loss 高到 0.1~0.8；P ≥ N 落到噪声地板附近",
        "每格按样本实测 λ_max 自动收紧 lr，避免 lr≥1/λ_max 时训练发散"
      ]
    }
  ]
}